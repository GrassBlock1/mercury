---
import TaxonomyPostsPage from '@/components/TaxonomyPostsPage.astro';
import { getPublishedPosts } from '@/utils/posts';
import { buildTaxonomyPaths } from '@/utils/taxonomy';

export async function getStaticPaths() {
    return buildTaxonomyPaths(await getPublishedPosts(), 'categories');
}

const { posts } = Astro.props;
---

<TaxonomyPostsPage term={Astro.params.category!} posts={posts} />
