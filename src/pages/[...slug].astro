---
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import BaseLayout from "../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug ?? "");
if (!slug) return Astro.rewrite("/404");
const { entry, error } = await getEmDashEntry("pages", slug);
if (error) {
	console.error(error);
	return new Response("Unable to load page", { status: 500 });
}
if (!entry) return Astro.rewrite("/404");
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt ?? ""} >
    <h1 class="title">{entry.data.title}</h1>
    <div class="content">
        <PortableText value={entry.data.content ?? []} />
    </div>
</BaseLayout>
