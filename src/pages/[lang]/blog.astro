---
import { getEmDashCollection } from "emdash";
import BlogListPage from "@/layouts/BlogList.astro";
import { toArticleListPosts } from "@/utils/emdash-posts";

const { lang } = Astro.params;
if (!lang) throw new Error("blog page requires a lang param");
const { entries, error } = await getEmDashCollection("posts", { locale: lang });
if (error) return new Response("Unable to load posts", { status: 500 });
const posts = toArticleListPosts(entries);
---

<BlogListPage posts={posts} />
