---
import { getLocalizedStaticPaths } from "@/i18n/utils";
import BlogListPage from "@/layouts/BlogList.astro";
import { getLocalizedPosts, sortByDateDesc } from "@/utils/posts";

export const getStaticPaths = getLocalizedStaticPaths;

const { lang } = Astro.params;
if (!lang) throw new Error("blog page requires a lang param");
const posts = sortByDateDesc(await getLocalizedPosts(lang));
---

<BlogListPage posts={posts} />
