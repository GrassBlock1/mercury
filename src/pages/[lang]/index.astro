---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import HomePage from "@/layouts/HomePage.astro";
import { getLocalizedStaticPaths } from "@/i18n/utils";

export const getStaticPaths = getLocalizedStaticPaths;

const { lang } = Astro.params;
// Conditionally import content if file exists
let HomePageContent: AstroComponentFactory | undefined;
try {
	const module = await import(`@/content/${lang}/index.md`);
	HomePageContent = module.Content;
} catch {
	// File doesn't exist or couldn't be imported
	console.log("Homepage content not found, using default content");
}
---

<HomePage content={HomePageContent} />
