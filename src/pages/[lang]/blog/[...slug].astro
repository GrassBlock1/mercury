---
import { decodeSlug, getEmDashEntry } from "emdash";
import PostPage from "@/layouts/Article.astro";

const slug = decodeSlug(Astro.params.slug ?? "");
if (!slug) return Astro.rewrite("/404");
const { entry, error } = await getEmDashEntry("posts", slug, {
	locale: Astro.params.lang,
});
if (error) return new Response("Unable to load post", { status: 500 });
if (!entry) return Astro.rewrite("/404");
---
<PostPage cmsEntry={entry} />
