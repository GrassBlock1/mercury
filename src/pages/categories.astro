---
import IndexLayout from "@/layouts/taxonomies/Index.astro";
import { getPublishedPosts } from "@/utils/posts";
import { collectTaxonomies } from "@/utils/taxonomy";

const items = collectTaxonomies(await getPublishedPosts(), "categories");
---

<IndexLayout
    title="Categoies"
    description="List all categories used in the blog posts."
    heading="~/blog/categories"
    command="ls categories/"
    basePath="/categories"
    listClass="category-list"
    items={items}
/>
