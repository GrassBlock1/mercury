---
import { getTaxonomyTerms } from "emdash";
import IndexLayout from "@/layouts/taxonomies/Index.astro";

const items = (await getTaxonomyTerms("tag")).map((term) => term.slug);
---

<IndexLayout
    title="Tags"
    description="List all tags used in the blog posts."
    heading="~/blog/tags"
    command="ls tags/"
    basePath="/tags"
    listClass="tags-list"
    items={items}
/>
