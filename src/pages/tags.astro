---
import TaxonomyIndexPage from '@/components/TaxonomyIndexPage.astro';
import { getPublishedPosts } from '@/utils/posts';
import { collectTaxonomies } from '@/utils/taxonomy';

const items = collectTaxonomies(await getPublishedPosts(), 'tags');
---

<TaxonomyIndexPage
    title="Tags"
    description="List all tags used in the blog posts."
    heading="~/blog/tags"
    command="ls tags/"
    basePath="/tags"
    listClass="tags-list"
    items={items}
/>
