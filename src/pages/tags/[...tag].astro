---
import { getEmDashCollection } from "emdash";
import PostsLayout from "@/layouts/taxonomies/Posts.astro";
import { toArticleListPosts } from "@/utils/emdash-posts";

const { entries, error } = await getEmDashCollection("posts", {
	where: { tag: Astro.params.tag },
});
if (error) return new Response("Unable to load tag", { status: 500 });
const posts = toArticleListPosts(entries);
---

<PostsLayout term={Astro.params.tag!} posts={posts} />
