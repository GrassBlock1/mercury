---
import { getEmDashEntry } from "emdash";
import HomePage from "@/layouts/HomePage.astro";

const { entry, error } = await getEmDashEntry("pages", "home");
if (error) {
	console.error(error);
	return new Response("Unable to load homepage", { status: 500 });
}
---

<HomePage emdashContent={entry?.data.content ?? []} />
