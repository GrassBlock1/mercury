---
import { Font } from "astro:assets";
import { i18n } from "astro:config/client";
import Meta from "@/components/helpers/head/Meta.astro";
import BackToTop from "../components/BackToTop.astro";
import Navbar from "../components/Navbar.astro";
import Search from "../components/Search.astro";
import Statistics from "../components/Statistics.astro";
import ThemeSwitcher_CSSOnly from "../components/ThemeSwitcher@CSSOnly.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { siteConfig } from "../config";
import globalCss from "../styles/global.css?inline";

interface Props {
	title?: string;
	description?: string;
	author?: string;
	path?: string;
	ogImage?: string;
}

import LanguagePicker from "@/components/helpers/i18n/LanguagePicker.astro";
import SPARouter from "@/components/helpers/spa/SPARouter.astro";
import Spinner from "@/components/helpers/spa/Spinner.astro";
import PoweredBy from "../components/PoweredBy.astro";

const spaEnabled = siteConfig.spa;

const noscript = siteConfig.noClientJavaScript;

const statisticsEnabled = siteConfig.siteAnalytics.enabled;

const defaultTitle = siteConfig.title;
const formattedRootPath = defaultTitle.toLowerCase().replace(/\s+/g, "-");
const relativePath = Astro.url.pathname;
const path = formattedRootPath + (relativePath === "/" ? "" : relativePath);

const pageTitle =
	relativePath === "/"
		? defaultTitle
		: `${Astro.props.title} - ${defaultTitle}`;
const ogTitle = Astro.props.title || defaultTitle;

const customFooter = siteConfig.customFooter;
const nekoType = siteConfig.neko?.type;

const {
	title = pageTitle,
	author = siteConfig.defaultAuthor.name,
	description = siteConfig.description,
	ogImage = "",
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <style is:inline set:html={globalCss}></style>
    <Font cssVariable="--font-mono" preload/>
    <slot name="head" />
    <Meta title={ogTitle} author={author} description={description} ogImage={ogImage}/>
    <title>{pageTitle}</title>
    {spaEnabled &&
            <SPARouter/>}
    <!--transitional animation is broken in firefox though-->
</head>
<body class="container">
{noscript &&
        <div id="top" style="visibility: hidden">Back To Top</div>}
<header>
    <div class="terminal-path">
        {path}
    </div>
    <Navbar/>
    <Search/>
    {spaEnabled &&
            <Spinner/>}
</header>
<main class="content-box">
    <slot/>
</main>

<footer class="footer">
    <LanguagePicker/>
    <div class="floating">
        <BackToTop/>
        {noscript ?
                <ThemeSwitcher_CSSOnly/> :
                <ThemeSwitcher/>}
    </div>
    <div class="container">
        <Fragment set:html={customFooter}/>
        <PoweredBy/>
    </div>
</footer>
{statisticsEnabled &&
        <Statistics/>}
{(siteConfig.neko.enabled && !noscript) &&
        <>
            <script is:inline define:vars={{nekoType}}>
                window.NekoType = nekoType;
            </script>
            <script is:inline src="https://webneko.net/n20171213.js"></script>
        </>
}
</body>
</html>