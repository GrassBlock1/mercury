---
import BaseLayout from "@/layouts/Base.astro";

interface Props {
	title: string;
	description: string;
	heading: string;
	command: string;
	basePath: string;
	listClass: string;
	items: string[];
}

const { title, description, heading, command, basePath, listClass, items } =
	Astro.props;
---

<BaseLayout title={title} description={description}>
    <h1 class="title">{heading}</h1>
    <div style="margin-top: 2rem;">
        <span class="command">{command}</span>
        <div style="margin-top: 1rem; margin-left: 1rem;" class={listClass}>
            {items.map((item) => (
                    <p><a href={`${basePath}/${item}`}>{item}</a></p>
            ))}
        </div>
    </div>
</BaseLayout>
<style>
    div.tags-list,
    div.category-list {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }
</style>
