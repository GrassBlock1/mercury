---
import ArticleList from "@/components/ArticleList.astro";
import BaseLayout from "@/layouts/Base.astro";
import type { PostEntry } from "@/utils/posts";

interface Props {
	term: string;
	posts: PostEntry[];
}

const { term, posts } = Astro.props;
---

<BaseLayout title={`posts tagged with ${term}`} description={`Posts tagged with ${term}`}>
    <h1 class="title">ls ~/blog | grep "{term}"</h1>
    <ul>
        <ArticleList posts={posts} displayDate={true} />
    </ul>
</BaseLayout>
