---
import ArticleList from "@/components/ArticleList.astro";
import BaseLayout from "@/layouts/Base.astro";

interface Props {
	term: string;
	posts: { id: string; data: { title: string; date: Date; draft?: boolean } }[];
}

const { term, posts } = Astro.props;
---

<BaseLayout title={`posts tagged with ${term}`} description={`Posts tagged with ${term}`}>
    <h1 class="title">ls ~/blog | grep "{term}"</h1>
    <ul>
        <ArticleList posts={posts} displayDate={true} />
    </ul>
</BaseLayout>
