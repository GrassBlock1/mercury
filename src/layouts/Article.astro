---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import {
	extractPlainText,
	type ImageValue,
	type PortableTextBlock,
} from "emdash";
import { Image as EmDashImage, PortableText } from "emdash/ui";
import katexCssUrl from "katex/dist/katex.css?url";
import CmsCode from "@/components/CmsCode.astro";
import Comments from "@/components/Comments.astro";
import CopyRight from "@/components/CopyRight.astro";
import AuthorInfo from "@/components/helpers/authors/Info.astro";
import MathText from "@/components/MathText.astro";
import OutDatedCallOut from "@/components/OutDatedCallOut.astro";
import ReplyViaEmail from "@/components/ReplyViaEmail.astro";
import TableOfContentsButton from "@/components/toc/Button.astro";
import TableOfContents from "@/components/toc/TableOfContents.astro";
import { siteConfig } from "@/config";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import BaseLayout from "@/layouts/Base.astro";
import { resolvePostCover } from "@/plugins/post-images";
import artalkCssUrl from "@/styles/artalk.css?url";
import { resolveAuthors } from "@/utils/posts";

interface Props {
	entry?: CollectionEntry<"posts">;
	cmsEntry?: {
		data: {
			title: string;
			excerpt?: string | null;
			summary?: string | null;
			featured_image?: ImageValue | null;
			content?: PortableTextBlock[] | null;
			original_date?: string | Date | null;
			original_updated?: string | Date | null;
			publishedAt?: Date | null;
			createdAt: Date;
			updatedAt: Date;
		};
	};
}

const { entry, cmsEntry } = Astro.props;
if (!entry && !cmsEntry) throw new Error("Article requires an entry");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];
const remarkPluginFrontmatter = rendered?.remarkPluginFrontmatter;
const hasMath =
	remarkPluginFrontmatter?.hasMath === true ||
	/\$\$[\s\S]+?\$\$|\$[^$\n]+?\$/.test(
		extractPlainText(cmsEntry?.data.content ?? []),
	);
const noscript = siteConfig.noClientJavaScript;
const commentsWithArtalk = !noscript && siteConfig.comments.type === "artalk";

// Get Wordcount and Last Updated Date
const wordcount = entry
	? (remarkPluginFrontmatter?.wordcount.words ?? 0)
	: extractPlainText(cmsEntry?.data.content ?? [])
			.trim()
			.split(/\s+/)
			.filter(Boolean).length;
const lastUpdated = entry
	? (entry.data.updated ??
		remarkPluginFrontmatter?.lastModified ??
		entry.data.date)
	: (cmsEntry?.data.original_updated ??
		cmsEntry?.data.original_date ??
		cmsEntry?.data.updatedAt ??
		new Date());
const title = entry?.data.title ?? cmsEntry?.data.title ?? "";
const description = entry?.data.description ?? cmsEntry?.data.excerpt ?? "";
const summary = entry?.data.summary ?? cmsEntry?.data.summary;
const date =
	entry?.data.date ??
	cmsEntry?.data.original_date ??
	cmsEntry?.data.publishedAt ??
	cmsEntry?.data.createdAt ??
	new Date();

const pubDate = new Date(date).toISOString().split("T")[0];
const lastUpdatedDate = new Date(lastUpdated).toISOString().split("T")[0];

const authors = entry
	? await resolveAuthors(entry)
	: [siteConfig.defaultAuthor];

// get featured image and use it as og:image
const { headerImage, cover } = entry
	? await resolvePostCover(entry, Content)
	: { headerImage: "", cover: "" };
---
<Fragment slot="head">
    {hasMath && <link rel="stylesheet" href={katexCssUrl} />}
    {commentsWithArtalk && <link rel="stylesheet" href={artalkCssUrl} media="print" onload="this.media='all'" />}
</Fragment>
<BaseLayout
  title={title}
  description={description}
  ogImage={typeof cover === 'string' ? cover : (cover as { src?: string })?.src}
  author={authors.map((a) => a.name).join(', ')}
>
    <article>
        <h1 class="title">{title}</h1>
            {authors.map((a) => <AuthorInfo data={a} />)}
        <span class="date">{pubDate}</span>
        {" "}
        {new Date(lastUpdated) > new Date(date) && <span class="date">({t('article.last_update')} {lastUpdatedDate})</span>}
        {" "}
        <span>|</span>{" "}
        <span class="wordcount">{wordcount} {t('article.word_count')}</span>
        { headerImage && <Image class="cover" width=720 height=480 src={headerImage} alt={`cover of ${title}`}  /> }
        { cmsEntry?.data.featured_image && <EmDashImage class="cover" image={cmsEntry.data.featured_image} alt={`cover of ${title}`} width={720} height={480} /> }
        {/* only display ToCs when there are <h2>s */}
        { headings.some(h => h.depth === 2) && <TableOfContents headings={headings} /> <TableOfContentsButton headings={headings}/>}
        {summary && <p class="summary">{summary}</p> }
        { siteConfig.outdatedCallout.enabled && (siteConfig.noClientJavaScript ? <OutDatedCallOut noscript=true lastUpdatedAt={lastUpdated} /> : <OutDatedCallOut server:defer lastUpdatedAt={lastUpdated} ><OutDatedCallOut noscript lastUpdatedAt={lastUpdated} slot="fallback" ></OutDatedCallOut></OutDatedCallOut>)}
        <div class="content">
            {Content ? <Content /> : <PortableText value={cmsEntry?.data.content ?? []} components={{ type: { code: CmsCode }, text: MathText }} />}
        </div>
    </article>
    <div class="extra-post" style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
        <CopyRight/>
        <ReplyViaEmail title={title} email={authors[0].email} lang={lang} />
        <p><a href="/blog">&larr; {t('article.back_to_posts')}</a></p>
        {!noscript && <h2>{t('article.comments')}</h2> <Comments pageTitle={title} />}
        {!noscript &&
            <script>
                import "katex/dist/contrib/copy-tex.js"
            </script>
        }
    </div>
</BaseLayout>
<style>
    p.summary {
        font-style: italic;
        color: var(--secondary-text-color);
        margin: 1rem;
    }
    img.cover {
        width: 100%;
        height: auto;
        margin: 1rem auto;
    }
</style>
