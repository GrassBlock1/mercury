---
import { h, TEXT_NODE, transform, walkSync } from "ultrahtml";
import sanitize from "ultrahtml/transformers/sanitize";
// instanceDomain: the domain of the fediverse instance (e.g., "example.com")
// userId: the user ID (could be the username when the instance uses software other than mastodon) of the account whose statuses you want to fetch
const { instanceDomain, userId } = Astro.props;
const response = await fetch(
    `https://${instanceDomain}/api/v1/accounts/${userId}/statuses?limit=1&exclude_replies=true`,
    {
        headers: {
            'Accept': 'application/json'
        }
    }
);
if (!response.ok) {
    console.warn(`unable to fetch status from ${userId}@${instanceDomain}`)
    return
}

const statuses = await response.json()
const status = statuses[0];
const emojis = new Map(
    (status?.emojis ?? []).flatMap(({ shortcode, url }) => {
        try {
            const imageUrl = new URL(url);
            return imageUrl.protocol === "https:" || imageUrl.protocol === "http:"
                ? [[shortcode, imageUrl.href]]
                : [];
        } catch {
            return [];
        }
    }),
);
const content = await transform(status?.content ?? "", [
    sanitize({
        allowElements: ["p", "br", "a", "span", "strong", "em", "code"],
        dropElements: ["script", "style", "iframe"],
    }),
    (document) => {
        const replacements = [];
        walkSync(document, (node, parent, index) => {
            if (node.type === TEXT_NODE && /:[^:\s]+:/u.test(node.value)) {
                replacements.push({ node, parent, index });
            }
        });

        for (const { node, parent, index } of replacements.reverse()) {
            const parts = [];
            let lastIndex = 0;
            for (const match of node.value.matchAll(/:([^:\s]+):/gu)) {
                const imageUrl = emojis.get(match[1]);
                if (!imageUrl) continue;
                parts.push({ ...node, value: node.value.slice(lastIndex, match.index) });
                parts.push(h("img", {
                    class: "custom-emoji",
                    src: imageUrl,
                    alt: match[0],
                    title: match[0],
                }));
                lastIndex = match.index + match[0].length;
            }
            if (parts.length) {
                parts.push({ ...node, value: node.value.slice(lastIndex) });
                parent.children.splice(index, 1, ...parts);
            }
        }
        return document;
    },
]);
---
<div class="fedi-status">
    <Fragment set:html={content}/>
</div>
<style>
    div.fedi-status {
        border: var(--border-color) 1px solid;
        padding: 1rem;
        margin: .5rem 0 0 0;
    }
</style>
<style is:inline>
    div.fedi-status p img.custom-emoji {
        height: 1.2em;
        width: auto;
        vertical-align: middle;
    }
</style>
